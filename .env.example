# Copy to .env.local for local development. Never commit real values.

# Auth (generate the secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database. Leave empty locally to use embedded PGlite in ./.data/pglite.
# On Vercel this comes from the Neon integration.
DATABASE_URL=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok linking (TikTok for Developers > your app > Login Kit)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Sign-in code emails. Leave empty locally to print codes in the terminal.
RESEND_API_KEY=
EMAIL_FROM="Clippifi <login@your-domain.com>"

# Old Firebase screens (/dashboard, /admin) until they are rebuilt
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Error tracking (optional). From sentry.io → Project → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Private beta (src/server/access.ts). Invite-only unless this is exactly "false".
# To launch publicly: PRIVATE_BETA=false. Approved emails live in the beta_allowlist table.
PRIVATE_BETA=
# The TikTok review team's account: this email is always approved and signs in with
# REVIEWER_CODE (6 digits) instead of an emailed code. Keep both secret.
REVIEWER_EMAIL=
REVIEWER_CODE=
